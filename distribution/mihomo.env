# Reviewed release pair for the public amd64/arm64 bundles and Docker images.
# SHA-256 covers compressed upstream assets. Compared with GitHub asset digests
# on 2026-10-22 (upstream v1.19.33, published 2026-10-21).
# v1.19.33 is the first release whose default builds use the Go 1.26.10
# toolchain, which carries the crypto/x509 distrust for the compromised
# eMudhra intermediate CAs (CVE-2026-111943); the pinned v1.19.32 was built
# with an unpatched Go. The -go120/-go123 compatibility variants in the same
# release are still unpatched — only the default assets below are reviewed.
MIHOMO_VERSION=v1.19.33
MIHOMO_AMD64_ASSET=mihomo-linux-amd64-v1-v1.19.33.gz
MIHOMO_AMD64_SHA256=8ec92e7b2fdc6b853ba00156bab7e4e965c8b0d843b8c4ac8ab98795f02ad524
MIHOMO_ARM64_ASSET=mihomo-linux-arm64-v1.19.33.gz
MIHOMO_ARM64_SHA256=ba408b317080ee265c46cb923a50018c1b82cbd708551cdd46a1e3e307396187
